# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"

# Shown as the SSID if the clock can't connect to WiFi
fallback_password: "bigclock-setup"

# 32-byte base64 key — generate with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Or let the ESPHome dashboard generate it when you add the device.
api_key: "your_esphome_api_key_here"

# Mosquitto MQTT broker (usually your HA host)
mqtt_host: "homeassistant.local"
mqtt_user: "your_mqtt_username"
mqtt_pass: "your_mqtt_password"
